<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:AccountsManagerApp.Desktop.Components"
        x:Class="AccountsManagerApp.Desktop.MainWindow"

        Title="{StaticResource ResourceKey=Title}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../../Templates/ButtonTemplates.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <StyleInclude Source="../../Styles/Styles.axaml" />
  </Window.Styles>

  <StackPanel Orientation="Horizontal"
              Classes="center">

    <Button x:Name="Button_Exit"
            Content="Назад"
            Classes="cancel"
            Template="{StaticResource ResourceKey=ButtonRightTemplate}"
            Click="Button_Exit_OnClick" />
  </StackPanel>
</Window>