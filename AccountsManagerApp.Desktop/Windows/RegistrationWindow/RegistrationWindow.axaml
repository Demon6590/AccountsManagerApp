<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:AccountsManagerApp.Desktop.Components"
        x:Class="AccountsManagerApp.Desktop.Windows.RegistrationWindow.RegistrationWindow"
        Width="600" Height="330"
        Title="{StaticResource ResourceKey=Title}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="../../Templates/ButtonTemplates.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Window.Styles>
    <StyleInclude Source="../../Styles/Styles.axaml" />
  </Window.Styles>
  <StackPanel Orientation="Vertical">
    <Panel Classes="center">
      <TextBlock Text="Регистрация"
                 Classes="title" />
    </Panel>

    <StackPanel Orientation="Vertical">
      <c:InputComponentMail x:Name="Input_Mail"
                            Placeholder="Введите почту"
                            Label="Почта" />
      <c:InputComponentPassword x:Name="Input_Password"
                                Placeholder="Введите пароль"
                                Label="Пароль" />
      <c:InputComponentPasswordConfirm x:Name="Input_Password_Confirm"
                                       Placeholder="Введите пароль повторно"
                                       Label="Повторите пароль" />
    </StackPanel>

    <StackPanel Orientation="Horizontal"
                Classes="center">
      <Button x:Name="Button_Login"
              Content="Зарегистрироваться"
              Classes="login"
              Template="{StaticResource ResourceKey=ButtonLeftTemplate}"
              Click="Button_Login_OnClick" />
      <Button x:Name="Button_Cancel"
              Content="Отмена"
              Classes="cancel"
              Template="{StaticResource ResourceKey=ButtonRightTemplate}"
              Click="Button_Cancel_OnClick" />
    </StackPanel>
    <StackPanel Orientation="Horizontal"
                Classes="center">
      <HyperlinkButton Content="Уже есть аккаунт? Войти"
                       Click="Open_AuthWindow_OnClick" />
      <HyperlinkButton Content="Восстановить доступ"
                       Click="Open_RestoringAccessWindow_OnClick" />
    </StackPanel>
  </StackPanel>
</Window>